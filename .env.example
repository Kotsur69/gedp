# Copy to .env and adjust. Placeholders only - never commit real secrets.

# --- Database (matches docker-compose.yml defaults; local dev only) ---
POSTGRES_USER=gedp
POSTGRES_PASSWORD=gedp_local_dev
POSTGRES_DB=gedp
POSTGRES_PORT=5432
DATABASE_URL="postgresql://gedp:gedp_local_dev@localhost:5432/gedp?schema=public"

# --- Auth.js (wired up in a later task) ---
# Generate with: npx auth secret
AUTH_SECRET=

