# Copy to .env and adjust. Placeholders only - never commit real secrets.

# --- Database (matches docker-compose.yml defaults; local dev only) ---
POSTGRES_USER=gedp
POSTGRES_PASSWORD=gedp_local_dev
POSTGRES_DB=gedp
POSTGRES_PORT=5432
DATABASE_URL="postgresql://gedp:gedp_local_dev@localhost:5432/gedp?schema=public"

# --- Supabase (current dev backend) - use INSTEAD of the local DATABASE_URL above ---
# Dashboard -> Connect -> "Session pooler" (port 5432, IPv4). Do NOT use the transaction pooler (6543)
# for migrations. Project ref and password stay in .env only.
# DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?schema=public"
# The seed refuses non-local hosts by default; for a dev Supabase project run:
#   SEED_ALLOW_REMOTE=1 npm run db:seed
# Migration 20261113090000_rls_lockdown enables RLS and revokes anon/authenticated (Data API) access.

# Application DB role (SEC-03). Created NOLOGIN by migration 20261109080000_audit_log_append_only,
# which grants it DML on all tables but revokes UPDATE/DELETE/TRUNCATE on audit_log.
# The name is hardcoded in that migration - change both together.
# DATABASE_URL above (owner) is for migrations; the running app should connect as this role.
# To enable it locally: ALTER ROLE gedp_app LOGIN PASSWORD '<local-dev-password>';
APP_DB_ROLE=gedp_app

# --- Auth.js ---
# Signs and encrypts the session cookie. Generate with: npx auth secret
AUTH_SECRET=
# Required behind a proxy / on a company server (not on Vercel): AUTH_TRUST_HOST=true
# AUTH_URL=https://gedp.example.com
# "Sign in as a seeded employee" picker. Synthetic data only, never with real people.
AUTH_DEV_LOGIN=true
# Production refuses AUTH_DEV_LOGIN unless this is also "true" (demo deployments only).
AUTH_DEV_LOGIN_ALLOW_IN_PRODUCTION=false
# Session ends after this many idle minutes (5-480, default 30).
AUTH_SESSION_IDLE_MINUTES=30

# --- E2E tests (optional: point at an already running app) ---
# PLAYWRIGHT_BASE_URL=http://localhost:3000
